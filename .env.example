# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documentos

# Redis (fila de ingestão)
REDIS_URL=redis://redis:6379

# Ollama
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_MODEL_FALLBACK=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SEGUNDOS=120

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# RAG
TOP_K_DEFAULT=5
SCORE_MINIMO=0.7

# API
API_PORT=8000
MAX_UPLOAD_SIZE_MB=20
LOG_LEVEL=INFO

# CORS (origens do frontend, separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Auth (admin único — POST /auth/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Conversas (memória multi-turn + auditoria de tokens)
MAX_TURNOS_HISTORICO=5
SQLITE_DB_PATH=/data/conversas.db
